# Supabase project: ontarget-panel-v2 (iwhjmhazcvctvipoasct)

# --- Frontend (Vite, build-time, bundled into the public JS) ---
# Publishable key only — NEVER put secret keys here (frontend bundle is public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (Hono app: server/ locally, api/[[...path]].ts on Vercel) ---
# Vercel Project Settings → Environment Variables. Do NOT prefix these VITE_.

# Supabase secret key (sb_secret_...) — server-side only; bypasses RLS.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Independent JWT signing secret for the custom panel session — NOT a Supabase
# secret of any kind. Generate with: openssl rand -hex 32
PANEL_JWT_SECRET=

# AES-256-GCM key used to encrypt TOTP secrets at rest (panel_users_2fa).
# Must decode to exactly 32 bytes, base64 or hex. Generate with: openssl rand -hex 32
# (2FA is not enforced at login today, but the enrollment endpoints are live.)
PANEL_2FA_ENC_KEY=

# Optional — ops Telegram notification on new checkout sessions.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
