# Supabase project: ontarget-panel-v2 (iwhjmhazcvctvipoasct)

# --- Frontend (Vite, build-time, bundled into the public JS) ---
# Publishable key only — NEVER put service_role keys here (frontend bundle is public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (Vercel serverless functions under /api, never bundled to the browser) ---
# Vercel Project Settings → Environment Variables. Do NOT prefix these VITE_.

# Supabase service role — used ONLY server-side by /api/auth/* to read/write
# panel_users, panel_users_2fa, panel_refresh_tokens (all RLS-enabled).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Independent JWT signing secret for the custom panel session — NOT a Supabase
# secret of any kind. Generate with: openssl rand -base64 48
PANEL_AUTH_JWT_SECRET=

# AES-256-GCM key used to encrypt TOTP secrets at rest (panel_users_2fa).
# Must decode to exactly 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
# (2FA is not enforced at login today, but the enrollment endpoints are live —
# see docs/AUTH.md — so this must still be set.)
PANEL_2FA_ENC_KEY=

# Optional pepper mixed into the password hash (sha256(pepper + password)).
# Leave EMPTY unless a real-password login test shows the legacy hashes need one
# — see docs/AUTH.md "Password hashing" section before setting this.
PANEL_PASSWORD_PEPPER=
