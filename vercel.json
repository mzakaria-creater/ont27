{
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/api-dashboard", "destination": "/index.html" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/delta-sync", "schedule": "* * * * *" },
    { "path": "/api/cron/delta-sync-full", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/auto-decline", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/wallet-rotation", "schedule": "*/5 * * * *" }
  ]
}
